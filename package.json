{
  "name": "tiple-method-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev --turbopack",
    "build": "node scripts/long-run.mjs build --freeze -- \"next build\"",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "next typegen && tsc --noEmit",
    "check:framework": "node scripts/check-framework.mjs",
    "verify": "node scripts/long-run.mjs verify --freeze -- \"pnpm check:framework && pnpm type-check && pnpm lint && pnpm test && node scripts/verify-receipt.mjs write\"",
    "verify:cached": "node scripts/verify-receipt.mjs check || pnpm verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/long-run.mjs test:e2e -- \"playwright test\"",
    "ui:shots": "node scripts/long-run.mjs ui:shots -- \"node scripts/ui-shots.mjs\"",
    "mcp:smoke": "node scripts/long-run.mjs mcp:smoke -- \"node scripts/smoke-mcp.mjs\"",
    "mcp:inspect": "npx @modelcontextprotocol/inspector",
    "bench:seed": "node scripts/bench-seed.mjs",
    "proto:seed": "node scripts/proto-seed.mjs",
    "proto:set": "node scripts/proto-set.mjs",
    "oauth:seed": "node scripts/oauth-seed.mjs",
    "oauth:member": "node scripts/oauth-member.mjs",
    "oauth:admin": "node scripts/oauth-admin.mjs",
    "bench:cc": "node scripts/bench-cc.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:migrate": "supabase migration new",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@hookform/resolvers": "^3",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.7.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26",
    "postcss": "^8",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.4.1"
}
