# ============================================
# Supabase (projet cloud — aucune stack locale)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clé secrète (sb_secret_…) : serveur uniquement, src/lib/supabase/admin.ts (ADR-002)
SUPABASE_SECRET_KEY=your-secret-key
# Personal access token de la CLI (supabase login --token …) — jamais en prod
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# ============================================
# IA — Claude API (si le projet utilise l'IA)
# ============================================
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Canal MCP (serveur /api/mcp)
# ============================================
# Phase 1 : endpoint PUBLIC, aucune auth (ADR-002). Transport stateless (ADR-001) :
# pas de REDIS_URL.
# Secret HMAC des ack du banc (S03) — requis en production dès que les leviers ack/gate servent
# BENCH_ACK_SECRET=une-chaine-aleatoire-longue
