# ============================================
# Supabase (projet cloud — aucune stack locale)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clé publique : serveur auth-test (E03), lecture de l'appartenance sous le jeton de l'utilisateur (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-key
# Clé secrète (sb_secret_…) : serveur uniquement, src/lib/supabase/admin.ts (ADR-002)
SUPABASE_SECRET_KEY=your-secret-key
# Mot de passe des deux comptes de test d'E03 (JB et son alias), posé par `pnpm oauth:seed` à leur
# création seulement (un compte existant garde le sien) ; jamais affiché
OAUTH_TEST_PASSWORD=choose-a-long-random-password
# Personal access token de la CLI (supabase login --token …) — jamais en prod
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# ============================================
# IA — Claude API (si le projet utilise l'IA)
# ============================================
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Canal MCP (serveur /api/mcp)
# ============================================
# Phase 1 : endpoint PUBLIC, aucune auth (ADR-002). Transport stateless (ADR-001) :
# pas de REDIS_URL.
# Secret HMAC des ack du banc (S03) — REQUIS en production : absent, bench_readme et la
# vérification d'ack jettent « BENCH_ACK_SECRET missing » (jamais de repli silencieux).
# En développement, repli "dev-secret" avec un avertissement console.
BENCH_ACK_SECRET=replace-with-a-long-random-string
